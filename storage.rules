rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Logo da empresa: qualquer pessoa pode visualizar (fica em cards, mensagens, etc.),
    // mas só a própria empresa autenticada pode enviar/substituir a sua logo.
    match /logos_empresas/{uid}.{ext} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Nega tudo o mais por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
