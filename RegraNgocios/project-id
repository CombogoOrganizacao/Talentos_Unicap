## 📊 Regras de Progresso do Currículo

### Cálculo de Completude
```javascript
function calcularProgresso(profile) {
  const camposObrigatorios = [
    'bio',
    'curso',
    'telefone',
    'cidade'
  ];
  
  const secoesObrigatorias = [
    'experiencias',
    'habilidades',
    'projetos',
    'certificados'
  ];
  
  let preenchidos = 0;
  const total = 8; // 4 campos + 4 seções
  
  // Verifica campos obrigatórios
  camposObrigatorios.forEach(campo => {
    if (profile[campo] && profile[campo].trim() !== '') {
      preenchidos++;
    }
  });
  
  // Verifica seções com pelo menos 1 item
  secoesObrigatorias.forEach(secao => {
    if (profile[secao] && profile[secao].length > 0) {
      preenchidos++;
    }
  });
  
  return Math.round((preenchidos / total) * 100);
}
```

### Mensagens de Progresso
```javascript
function getMensagemProgresso(porcentagem) {
  if (porcentagem < 50) return 'Continue preenchendo!';
  if (porcentagem < 100) return 'Quase lá!';
  return 'Parabéns! Currículo completo!';
}
```

